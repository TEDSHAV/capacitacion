NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SHELL_URL=
MISTRAL_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SIGNING_SECRET=

# Shared secret for triggering requisicion notifications through the shell's
# /api/requisiciones/notify endpoint. Must match the shell app's
# REQUISICIONES_NOTIFY_SECRET. Optional in dev (notifications silently skipped).
REQUISICIONES_NOTIFY_SECRET=

# ExchangeRate-API key (USD→VES) used by the ported requisiciones module.
# Optional; if unset, USD/VES conversion is skipped.
EXCHANGERATE_API_KEY=

# Public URL of THIS capacitacion module (used to build QR verification URLs).
# Must be set to the externally reachable domain, e.g. https://capacitacion.shadevenezuela.com.ve
# NEXT_PUBLIC_SHELL_URL is the shell app's URL (auth redirects, CSP, navigation) and must NOT be reused for QRs.
NEXT_PUBLIC_APP_URL=