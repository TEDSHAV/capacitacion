# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key


# Shell Auth URL (if using external auth)
NEXT_PUBLIC_SHELL_URL=your-shell-url

# Public URL of THIS capacitacion module (used to build QR verification URLs).
# e.g. https://capacitacion.shadevenezuela.com.ve
NEXT_PUBLIC_APP_URL=your-app-url

# Mistral API Key (server-side only — do NOT use NEXT_PUBLIC_ prefix)
MISTRAL_API_KEY=your-mistral-api-key
SUPABASE_SERVICE_ROLE_KEY=

# Session signing secret (random 32+ byte hex string — generate with: openssl rand -hex 32)
SESSION_SIGNING_SECRET=

# Cookie Security
# Set to "false" when serving over HTTP (no SSL) so browsers accept auth cookies
NEXT_PUBLIC_COOKIE_SECURE=false
